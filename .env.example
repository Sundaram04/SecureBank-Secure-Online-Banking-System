# ========================================================
# SECUREBANK ENVIRONMENT CONFIGURATION (.env.example)
# ========================================================

# Server Port
SERVER_PORT=8080

# Database Configuration (PostgreSQL running locally)
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/securebank_db
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=postgres

# Master AES-256-GCM Encryption Key (64 hex characters / 256 bits)
SECUREBANK_AES_SECRET_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# CORS Configuration
SECUREBANK_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Frontend API Target
VITE_API_URL=http://localhost:8080/api
